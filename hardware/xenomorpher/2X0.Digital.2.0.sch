<part name="L2" library="2X0-Library-extras" library_urn="urn:adsk.wipprod:fs.file:vf.MzGkZwb-SXW1AXCMC33p5Q" deviceset="ASPI-4030S-100M-T" device="" package3d_urn="urn:adsk.eagle:package:48067865/1" value="10uH">
